<mxfile host='app.diagrams.net' modified='2026-07-09T00:00:00.000Z' agent='Claude' version='20.8.16' type='device'>
  <diagram id='86b66387b1dd40e1' name='Line 1b - Household employee wages (not on W-2)'>
    <mxGraphModel dx='1600' dy='1100' grid='1' gridSize='10' guides='1' tooltips='1' connect='1' arrows='1' fold='1' page='1' pageScale='1' pageWidth='1700' pageHeight='1320' math='0' shadow='0'>
      <root>
        <mxCell id='0'/>
        <mxCell id='1' parent='0'/>

        <!-- Legend -->
        <mxCell id='legend' value='Legend&#xa;◆ yellow diamond = decision gate&#xa;▢ green = computation / accumulation&#xa;▢ red = blocking flag or terminal null&#xa;▢ blue = Form 1040 output&#xa;▢ purple = MFS handling&#xa;▢ gray = input / reference data' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#6c757d;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;' vertex='1' parent='1'><mxGeometry x='60' y='20' width='300' height='150' as='geometry'/></mxCell>

        <!-- START -->
        <mxCell id='start' value='START&#xa;employment-income-{taxpayer|spouse}&#xa;householdEmployeeAmount() per person' style='ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c84b8;fontSize=12;fontStyle=1;' vertex='1' parent='1'><mxGeometry x='500' y='20' width='300' height='70' as='geometry'/></mxCell>

        <!-- Gate 1: hasEmploymentIncome -->
        <mxCell id='g1' value='hasEmploymentIncome = true?' style='rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;' vertex='1' parent='1'><mxGeometry x='510' y='130' width='280' height='80' as='geometry'/></mxCell>
        <mxCell id='e_start_g1' style='endArrow=block;html=1;' edge='1' source='start' target='g1' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <!-- Gate 1 -> No: null -->
        <mxCell id='null1' value='line 1b = null&#xa;(no employment income)' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;' vertex='1' parent='1'><mxGeometry x='860' y='140' width='200' height='60' as='geometry'/></mxCell>
        <mxCell id='e_g1_no' value='No' style='endArrow=block;html=1;exitX=1;exitY=0.5;' edge='1' source='g1' target='null1' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <!-- Gate 2: householdWork -->
        <mxCell id='g2' value='householdWork = true?' style='rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;' vertex='1' parent='1'><mxGeometry x='510' y='250' width='280' height='80' as='geometry'/></mxCell>
        <mxCell id='e_g1_yes' value='Yes' style='endArrow=block;html=1;' edge='1' source='g1' target='g2' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <!-- Gate 2 -> No: null for line 1b -->
        <mxCell id='null2' value='line 1b = null&#xa;(not household work — wages, if any,&#xa;belong on line 1a via a W-2)' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;' vertex='1' parent='1'><mxGeometry x='860' y='250' width='230' height='70' as='geometry'/></mxCell>
        <mxCell id='e_g2_no' value='No' style='endArrow=block;html=1;exitX=1;exitY=0.5;' edge='1' source='g2' target='null2' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <!-- Gap 4: MISSING_W2 handoff on the householdWork = false path -->
        <mxCell id='missing_w2' value='validateEmploymentIncomeW2ForPerson()&#xa;&#xa;householdWork = false AND no W-2 for SSN&#xa;AND no Form 4852 W-2 substitute&#xa;⇒ blocking flag&#xa;MISSING_W2_EMPLOYMENT_INCOME_{TAXPAYER|SPOUSE}&#xa;&#xa;SUPPRESSED when householdWork = true (the Yes&#xa;branch above) or a W-2 / Form 4852 is present.' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;' vertex='1' parent='1'><mxGeometry x='1130' y='230' width='360' height='150' as='geometry'/></mxCell>
        <mxCell id='e_null2_missing' value='+ employment income&#xa;without a W-2' style='endArrow=block;html=1;dashed=1;strokeColor=#b85450;' edge='1' source='null2' target='missing_w2' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <!-- Gate 3: control test -->
        <mxCell id='g3' value='householdEmployeeUnderControlTest = true?' style='rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;' vertex='1' parent='1'><mxGeometry x='510' y='370' width='280' height='80' as='geometry'/></mxCell>
        <mxCell id='e_g2_yes' value='Yes' style='endArrow=block;html=1;' edge='1' source='g2' target='g3' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <!-- Gate 3 -> No: blocking flag + Schedule C note -->
        <mxCell id='flag_se' value='Blocking flag (validateHouseholdEmployeeControlTest):&#xa;HOUSEHOLD_WORK_SELF_EMPLOYMENT_{TAXPAYER|SPOUSE}&#xa;&#xa;Failed the control test ⇒ worker is self-employed.&#xa;→ Schedule C / SE (out of scope). Fires only on&#xa;explicit false; null is tolerated for legacy data.' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;' vertex='1' parent='1'><mxGeometry x='860' y='360' width='360' height='110' as='geometry'/></mxCell>
        <mxCell id='e_g3_no' value='No' style='endArrow=block;html=1;exitX=1;exitY=0.5;' edge='1' source='g3' target='flag_se' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <!-- Gate 4: receivedW2 -->
        <mxCell id='g4' value='householdReceivedW2 = false?' style='rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;' vertex='1' parent='1'><mxGeometry x='510' y='490' width='280' height='80' as='geometry'/></mxCell>
        <mxCell id='e_g3_yes' value='Yes' style='endArrow=block;html=1;' edge='1' source='g3' target='g4' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <!-- Gate 4 -> No (W-2 received): -> line 1a -->
        <mxCell id='line1a' value='W-2 was issued ⇒ wages belong on line 1a&#xa;(W-2 box 1). line 1b = null for this person.' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;' vertex='1' parent='1'><mxGeometry x='860' y='500' width='260' height='60' as='geometry'/></mxCell>
        <mxCell id='e_g4_no' value='No&#xa;(W-2 received)' style='endArrow=block;html=1;exitX=1;exitY=0.5;' edge='1' source='g4' target='line1a' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <!-- Gate 5: MFS -->
        <mxCell id='g5' value='Filing status = MFS?' style='rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;' vertex='1' parent='1'><mxGeometry x='510' y='610' width='280' height='80' as='geometry'/></mxCell>
        <mxCell id='e_g4_yes' value='Yes&#xa;(no W-2)' style='endArrow=block;html=1;' edge='1' source='g4' target='g5' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <!-- Gate 5 -> Yes: skip spouse -->
        <mxCell id='mfs_note' value='Aggregate taxpayer employers only.&#xa;Spouse employers skipped — MFS filers&#xa;each file their own return.' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;' vertex='1' parent='1'><mxGeometry x='860' y='620' width='260' height='70' as='geometry'/></mxCell>
        <mxCell id='e_g5_yes' value='Yes' style='endArrow=block;html=1;exitX=1;exitY=0.5;' edge='1' source='g5' target='mfs_note' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <!-- Per-employer loop -->
        <mxCell id='loop' value='For each employer in householdEmployers[]' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;' vertex='1' parent='1'><mxGeometry x='510' y='730' width='280' height='60' as='geometry'/></mxCell>
        <mxCell id='e_g5_no' value='No (MFJ/Single/HOH)' style='endArrow=block;html=1;' edge='1' source='g5' target='loop' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>
        <mxCell id='e_mfs_loop' style='endArrow=block;html=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;' edge='1' source='mfs_note' target='loop' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <!-- Gate 6: employerTreatedAsContractor collision guard (line 1g / Form 8919 handoff) -->
        <mxCell id='g6' value='employer.employerTreatedAsContractor = true?' style='rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;' vertex='1' parent='1'><mxGeometry x='500' y='830' width='300' height='90' as='geometry'/></mxCell>
        <mxCell id='e_loop_g6' style='endArrow=block;html=1;' edge='1' source='loop' target='g6' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <!-- Gate 6 -> Yes: skip employer (collision guard, line 1g handoff) -->
        <mxCell id='collision' value='SKIP this employer from line 1b.&#xa;Collision guard: employer issued a 1099 (contractor),&#xa;so the wages flow through Form 8919 → line 1g.&#xa;Including here would double-count line 1b + line 1g.' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;' vertex='1' parent='1'><mxGeometry x='860' y='820' width='300' height='100' as='geometry'/></mxCell>
        <mxCell id='e_g6_yes' value='Yes&#xa;(contractor → line 1g)' style='endArrow=block;html=1;exitX=1;exitY=0.5;' edge='1' source='g6' target='collision' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <!-- Gap 5: per-employer federalTaxWithheld reconciliation branch -->
        <mxCell id='g7' value='employer.federalTaxWithheld = true?&#xa;(validateWithholdingOnContractorHouseholdFirm)' style='rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;' vertex='1' parent='1'><mxGeometry x='1210' y='800' width='280' height='90' as='geometry'/></mxCell>
        <mxCell id='e_collision_g7' style='endArrow=block;html=1;' edge='1' source='collision' target='g7' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <mxCell id='wh_none' value='No withholding —&#xa;nothing to reconcile.' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;' vertex='1' parent='1'><mxGeometry x='1230' y='690' width='240' height='60' as='geometry'/></mxCell>
        <mxCell id='e_g7_no' value='No' style='endArrow=block;html=1;exitX=0.5;exitY=0;' edge='1' source='g7' target='wh_none' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <mxCell id='g8' value='Matching 1099-MISC / 1099-NEC&#xa;on file (payer-name match)?' style='rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;' vertex='1' parent='1'><mxGeometry x='1210' y='930' width='280' height='90' as='geometry'/></mxCell>
        <mxCell id='e_g7_yes' value='Yes' style='endArrow=block;html=1;' edge='1' source='g7' target='g8' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <mxCell id='wh_ok' value='Withholding flows to Form 1040 line 25b&#xa;from the 1099 Box 4. No flag.' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;' vertex='1' parent='1'><mxGeometry x='860' y='945' width='280' height='60' as='geometry'/></mxCell>
        <mxCell id='e_g8_yes' value='Yes' style='endArrow=block;html=1;exitX=0;exitY=0.5;' edge='1' source='g8' target='wh_ok' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <mxCell id='flag_wh' value='Blocking flag:&#xa;WITHHOLDING_ON_CONTRACTOR_HOUSEHOLD_FIRM_&#xa;NEEDS_1099_STATEMENT_{TAXPAYER|SPOUSE}&#xa;&#xa;Withheld income tax cannot reach line 25b — no&#xa;matching 1099 on file. User must add the 1099&#xa;statement, clear federalTaxWithheld, or override.' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;' vertex='1' parent='1'><mxGeometry x='1210' y='1060' width='380' height='140' as='geometry'/></mxCell>
        <mxCell id='e_g8_no' value='No' style='endArrow=block;html=1;' edge='1' source='g8' target='flag_wh' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <!-- Accumulate wages -->
        <mxCell id='accum' value='total += employer.wages' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;' vertex='1' parent='1'><mxGeometry x='510' y='960' width='280' height='60' as='geometry'/></mxCell>
        <mxCell id='e_g6_no' value='No&#xa;(include in line 1b)' style='endArrow=block;html=1;' edge='1' source='g6' target='accum' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <!-- Output -->
        <mxCell id='out' value='line 1b = roundHalfUp(total)&#xa;→ Form 1040 line 1b (household wages)&#xa;→ Form 1040 line 1z (total wages)&#xa;→ Form 1040 line 9 (total income)' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c84b8;fontSize=12;fontStyle=1;' vertex='1' parent='1'><mxGeometry x='490' y='1070' width='320' height='100' as='geometry'/></mxCell>
        <mxCell id='e_accum_out' style='endArrow=block;html=1;' edge='1' source='accum' target='out' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

        <!-- Reference data box -->
        <mxCell id='ref' value='Reference Data&#xa;W-2 threshold (2025): $2,800&#xa;(employer obligation to issue a W-2;&#xa;NOT an eligibility gate for line 1b)' style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#6c757d;fontSize=11;fontStyle=2;' vertex='1' parent='1'><mxGeometry x='100' y='490' width='300' height='80' as='geometry'/></mxCell>
        <mxCell id='e_ref' style='endArrow=open;dashed=1;html=1;' edge='1' source='ref' target='g4' parent='1'><mxGeometry relative='1' as='geometry'/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
